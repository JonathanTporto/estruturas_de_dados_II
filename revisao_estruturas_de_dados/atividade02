# Exercício 4 – Inversão de vetor


#include <stdio.h>

int main() {

    int v[10];

    // Leitura do vetor
    for(int i = 0; i < 10; i++) {
        scanf("%d", &v[i]);
    }

    // Troca os elementos das extremidades
    for(int i = 0; i < 5; i++) {

        int aux = v[i];

        v[i] = v[9 - i];
        v[9 - i] = aux;
    }

    printf("Vetor invertido:\n");

    for(int i = 0; i < 10; i++) {
        printf("%d ", v[i]);
    }

    return 0;
}


