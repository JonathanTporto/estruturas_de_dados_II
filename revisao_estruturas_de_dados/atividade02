# Exercício 1 – Soma de um vetor


#include <stdio.h>

int main() {

    int v[10];      // Vetor para armazenar 10 números
    int soma = 0;   // Variável para acumular a soma

    // Leitura dos valores
    for(int i = 0; i < 10; i++) {
        scanf("%d", &v[i]);
        soma += v[i];
    }

    // Exibição dos números digitados
    printf("Valores: ");
    for(int i = 0; i < 10; i++) {
        printf("%d ", v[i]);
    }

    // Exibição da soma e média
    printf("\nSoma = %d", soma);
    printf("\nMedia = %.2f", soma / 10.0);

    return 0;
}


