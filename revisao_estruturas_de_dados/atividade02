# Exercício 2 – Maior e menor valor


#include <stdio.h>

int main() {

    int v[10];

    // Leitura dos valores
    for(int i = 0; i < 10; i++) {
        scanf("%d", &v[i]);
    }

    // Inicializa com o primeiro elemento
    int maior = v[0];
    int menor = v[0];
    int posMaior = 0;
    int posMenor = 0;

    // Procura maior e menor valor
    for(int i = 1; i < 10; i++) {

        if(v[i] > maior) {
            maior = v[i];
            posMaior = i;
        }

        if(v[i] < menor) {
            menor = v[i];
            posMenor = i;
        }
    }

    printf("Maior valor: %d\n", maior);
    printf("Posicao: %d\n", posMaior);

    printf("Menor valor: %d\n", menor);
    printf("Posicao: %d\n", posMenor);

    return 0;
}


