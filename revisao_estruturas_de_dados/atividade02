# Exercício 8 – Struct Produto


#include <stdio.h>

struct Produto {

    char nome[50];
    int codigo;
    float preco;
    int quantidade;
};

int main() {

    struct Produto produtos[5];

    float maiorValor = 0;
    int indiceMaior = 0;

    // Cadastro dos produtos
    for(int i = 0; i < 5; i++) {

        scanf("%s", produtos[i].nome);
        scanf("%d", &produtos[i].codigo);
        scanf("%f", &produtos[i].preco);
        scanf("%d", &produtos[i].quantidade);

        // Calcula valor em estoque
        float valor =
            produtos[i].preco *
            produtos[i].quantidade;

        // Verifica maior valor
        if(valor > maiorValor) {

            maiorValor = valor;
            indiceMaior = i;
        }
    }

    printf("Produto com maior valor em estoque:\n");
    printf("%s\n", produtos[indiceMaior].nome);

    return 0;
}


