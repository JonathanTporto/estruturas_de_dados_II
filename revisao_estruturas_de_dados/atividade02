# Exercício 3 – Números pares


#include <stdio.h>

int main() {

    int v[20];
    int soma = 0;
    int quantidade = 0;

    // Leitura dos números
    for(int i = 0; i < 20; i++) {
        scanf("%d", &v[i]);
    }

    printf("Numeros pares:\n");

    // Verifica quais são pares
    for(int i = 0; i < 20; i++) {

        if(v[i] % 2 == 0) {

            printf("%d ", v[i]);

            soma += v[i];
            quantidade++;
        }
    }

    printf("\nQuantidade de pares: %d", quantidade);
    printf("\nSoma dos pares: %d", soma);

    return 0;
}


