# Exercício 5 – Matriz 3x3


#include <stdio.h>

int main() {

    int matriz[3][3];
    int soma = 0;
    int maior;

    // Leitura da matriz
    for(int i = 0; i < 3; i++) {

        for(int j = 0; j < 3; j++) {

            scanf("%d", &matriz[i][j]);

            soma += matriz[i][j];

            // Primeiro elemento inicia o maior valor
            if(i == 0 && j == 0) {
                maior = matriz[i][j];
            }

            if(matriz[i][j] > maior) {
                maior = matriz[i][j];
            }
        }
    }

    printf("Soma = %d\n", soma);
    printf("Maior valor = %d\n", maior);

    return 0;
}


