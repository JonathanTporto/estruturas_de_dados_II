# Exercício 10 – Sistema de Funcionários


#include <stdio.h>

struct Funcionario {

    char nome[50];
    int idade;
    char cargo[50];
    float salario;
};

int main() {

    struct Funcionario funcionarios[10];

    float somaSalarios = 0;
    float maiorSalario = 0;
    int indiceMaior = 0;

    // Cadastro dos funcionários
    for(int i = 0; i < 10; i++) {

        scanf("%s", funcionarios[i].nome);
        scanf("%d", &funcionarios[i].idade);
        scanf("%s", funcionarios[i].cargo);
        scanf("%f", &funcionarios[i].salario);

        somaSalarios += funcionarios[i].salario;

        // Verifica maior salário
        if(i == 0 ||
           funcionarios[i].salario > maiorSalario) {

            maiorSalario = funcionarios[i].salario;
            indiceMaior = i;
        }
    }

    // Calcula média salarial
    float media = somaSalarios / 10;

    printf("Media salarial: %.2f\n", media);

    printf("Funcionario com maior salario:\n");
    printf("%s\n", funcionarios[indiceMaior].nome);

    return 0;
}

