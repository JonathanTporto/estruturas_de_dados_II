# Exercício 6 – Diagonal principal


#include <stdio.h>

int main() {

    int matriz[4][4];
    int soma = 0;

    // Leitura da matriz
    for(int i = 0; i < 4; i++) {

        for(int j = 0; j < 4; j++) {
            scanf("%d", &matriz[i][j]);
        }
    }

    printf("Diagonal principal: ");

    // Elementos onde linha = coluna
    for(int i = 0; i < 4; i++) {

        printf("%d ", matriz[i][i]);

        soma += matriz[i][i];
    }

    printf("\nSoma da diagonal = %d", soma);

    return 0;
}


